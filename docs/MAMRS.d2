direction: down

classes: {
  question: {
    style: {
      font-size: 14
      stroke: blue
      fill: "#e6f3ff"
    }
  }
  child: {
    style: {
      font-size: 14
      stroke: green
      fill: "#e6ffe6"
    }
  }
  container: {
    style: {
      stroke: green
      stroke-dash: 5
      border-radius: 10
      fill: "#f5fff5"
    }
  }
}

# Initial question positioned at top center
completion: How is the Health Risk Assessment being completed? {
  class: question
  near: top-center
}

# Initial sequence
answerer: Who is answering the questions? {class: question}
language: Primary Language {class: question}
hispanic: Are you of Hispanic, Latino, or Spanish origin? {class: question}
race: What is your Primary Race? {class: question}
veteran: Are you a veteran? {class: question}

# VA container
va_questions: {
  class: container
  va_care: If you are a veteran, do you get health care at the VA? {class: child}
  va_location: If yes, please provide the name of the VA clinic or Address {class: child}
}

# Rest of initial sequence
marital: What is your marital status? {class: question}
pcp: Name of Primary Care Physician {class: question}
docs: Do you have any of the following: {class: question}

# Documents container
doc_questions: {
  class: container
  living_will: Living will {class: child}
  poa: POA {class: child}
  adv_dir: Advanced Directive {class: child}
  caregiver: Caregiver {class: child}
  caregiver_details: If you have a care giver, please provide name and phone number {class: child}
  health_proxy: Healthcare proxy {class: child}
}

height_measure: height {class: question}

# Height container
height_parts: {
  class: container
  feet: Feet {class: child}
  inches: Inches {class: child}
}

# Middle sequence
weight: Weight {class: question}
allergies: Do you have any medication allergies? {class: question}
list_allergies: Please list your allergies {class: question}
prescriptions: How many prescription drugs do you take? {class: question}
exercise: How many days a week do you normally get 20 minutes or more of exercise/activity? {class: question}
tobacco: Do you smoke or use tobacco products? {class: question}
drugs: Do you use recreational drugs? {class: question}
alcohol: How many alcoholic drinks do you have in a normal week? {class: question}
pain: Do you currently suffer from any pain? (Chronic or Acute) {class: question}
pain_scale: On a scale of 1-5 how do you rate your pain {class: question}
fruits_veg: Over the past 7 days, how many servings of fruits or vegetables did you eat each day? {class: question}
special_diet: Are you on a special diet for medical or personal reason? {class: question}
diet_type: If you are on a special diet please indicate what type of diet {class: child}
health_status: In general, would you say your health is: {class: question}

# Medical conditions section
conditions: Do you currently or have you ever been told you have any of the following conditions? {class: question}

medical_conditions: {
  class: container
  lung: Lung Problems (COPD, asthma, chronic bronchitis, emphysema, pulmonary fibrosis) {class: child}
  cancer: Active Cancer {class: child}
  diabetes: Diabetes {class: child}
  heart: Heart Problems (A Fib, A Flutter, Super Ventricular Tachycardia, Congestive Heart Failure, Coronary Heart Disease, Angina, history of MI) {class: child}
  vascular: Vascular Disease {class: child}
  blood: Blood disorders (sickle cell, clotting disorders) {class: child}
  autoimmune: Auto Immune disorders (rheumatoid arthritis, psoriatic arthritis, lupus, scleroderma, other) {class: child}
  viral: Chronic Viral Infection (HIV, Hep B or C) {class: child}
  kidney: Kidney Disease (CKD, other) {class: child}
  mental: Mental Health (anxiety, depression, bipolar, schizophrenia, PTSD) {class: child}
  gi: Gastrointestinal issues (ulcerative colitis, Crohn's Disease) {class: child}
  neuro: Neurological (Alzheimer's, dementia, Parkinson's, convulsions, MS, history of stroke) {class: child}
  pregnant: Currently pregnant {class: child}
  other_conditions: Other {class: child}
}

# Later sequence
hospital: How many times have you been admitted to the hospital in the last 12 months? {class: question}
adl: Do you need help with any of the following? {class: question}

# ADL container
adl_questions: {
  class: container
  bathing: Bathing {class: child}
  transfer: Transferring: Getting in and out of a chair or a bed {class: child}
  dressing: Dressing: this includes taking clothes off and putting clothes on, reaching above your head, and using buttons and zippers {class: child}
  eating: Eating: this includes cutting your food and opening any containers with food inside {class: child}
  bathroom: Using the bathroom: this includes pulling clothes up and down, and cleaning yourself {class: child}
  walking: Walking: walking more than 10 feet without using a walker, cane, or holding onto furniture {class: child}
  meals: Making your meals: this includes cleaning food, cutting foods, and cooking {class: child}
  shopping: Shopping: this includes getting groceries and other items needed for your home {class: child}
  meds: Medication management: this includes taking your medications on time, getting refills {class: child}
}

# Social determinants
transport: Has the lack of transportation kept you from medical appointments, meetings, work or from getting things need for daily living? {class: question}
housing: Are you worried or concerned that in the next two months you may not have stable housing that you own, rent, or stay in as a part of a household? {class: question}
home_issues: Do have problems with any of the following at the place you live? {class: question}

# Home issues container
home_problems: {
  class: container
  bugs: Bug Infestation {class: child}
  mold: Mold {class: child}
  lead: Lead Pipes {class: child}
  handrails: No solid hand rails {class: child}
  stove: Oven or stove not working {class: child}
  smoke: No or non-working smoke detectors {class: child}
  water: Water leaks {class: child}
  rugs: Loose Rugs {class: child}
  co: No or not working Carbon Monoxide detector {class: child}
  lighting: No good lighting in walkways {class: child}
  no_issues: None {class: child}
}

# Final sequence
food_worry: Within the last 12 months have you worried that your food would run out before you had money to buy more? {class: question}
food_out: Within the last 12 months, the food you bought just didn't last and you didn't have money to get more? {class: question}
abuse: Does anyone, including friends and family, physically, emotionally, or financially try to hurt you? {class: question}
screenings: Have you had any of the following preventive screenings: {class: question}

# Preventive screening container
screening_questions: {
  class: container
  pap: FEMALE AGED 21+: Have you had a Pap Smear (Cervical Cancer) in the last 12 months? {class: child}
  mammo: FEMALE AGED 45+: Have you had a mammogram in the past 24 months? {class: child}
  colorectal: MALE/FEMALE 45+: Have you had a colorectal cancer screening? {class: child}
  screening_type: What type of colorectal screening have you had? {class: child}
  screening_date: Date of your last Colorectal screening {class: child}
  screening_results: Results of your last colorectal screening {class: child}
}

flu: Have you had a Flu Vaccine in the last year? {class: question}
pneumonia: Have you had a Pneumonia Vaccine? {class: question}

# Main sequence connections
completion -> answerer -> language -> hispanic -> race -> veteran -> va_questions -> marital -> pcp -> docs -> doc_questions -> height_measure -> height_parts -> weight -> allergies -> list_allergies -> prescriptions -> exercise -> tobacco -> drugs -> alcohol -> pain -> pain_scale -> fruits_veg -> special_diet -> health_status -> conditions -> medical_conditions -> hospital -> adl -> adl_questions -> transport -> housing -> home_issues -> home_problems -> food_worry -> food_out -> abuse -> screenings -> screening_questions -> flu -> pneumonia

# VA connections
veteran -> va_questions.va_care: {style.stroke-dash: 5; label: If Yes}
va_questions.va_care -> va_questions.va_location: {style.stroke-dash: 5; label: If Yes}

# Document connections
docs -> doc_questions.living_will
docs -> doc_questions.poa
docs -> doc_questions.adv_dir
docs -> doc_questions.caregiver
docs -> doc_questions.health_proxy
doc_questions.caregiver -> doc_questions.caregiver_details: {style.stroke-dash: 5; label: If Yes}

# Height connections
height_measure -> height_parts.feet
height_measure -> height_parts.inches

# Special diet connection
special_diet -> diet_type: {style.stroke-dash: 5; label: If Yes}

# Medical condition connections
conditions -> medical_conditions.lung
conditions -> medical_conditions.cancer
conditions -> medical_conditions.diabetes
conditions -> medical_conditions.heart
conditions -> medical_conditions.vascular
conditions -> medical_conditions.blood
conditions -> medical_conditions.autoimmune
conditions -> medical_conditions.viral
conditions -> medical_conditions.kidney
conditions -> medical_conditions.mental
conditions -> medical_conditions.gi
conditions -> medical_conditions.neuro
conditions -> medical_conditions.pregnant
conditions -> medical_conditions.other_conditions

# ADL connections
adl -> adl_questions.bathing
adl -> adl_questions.transfer
adl -> adl_questions.dressing
adl -> adl_questions.eating
adl -> adl_questions.bathroom
adl -> adl_questions.walking
adl -> adl_questions.meals
adl -> adl_questions.shopping
adl -> adl_questions.meds

# Home issues connections
home_issues -> home_problems.bugs
home_issues -> home_problems.mold
home_issues -> home_problems.lead
home_issues -> home_problems.handrails
home_issues -> home_problems.stove
home_issues -> home_problems.smoke
home_issues -> home_problems.water
home_issues -> home_problems.rugs
home_issues -> home_problems.co
home_issues -> home_problems.lighting
home_issues -> home_problems.no_issues

# Preventive screening connections
screenings -> screening_questions.pap
screenings -> screening_questions.mammo
screenings -> screening_questions.colorectal
screening_questions.colorectal -> screening_questions.screening_type: {style.stroke-dash: 5; label: If Yes}
screening_questions.colorectal -> screening_questions.screening_date: {style.stroke-dash: 5; label: If Yes}
screening_questions.colorectal -> screening_questions.screening_results: {style.stroke-dash: 5; label: If Yes}
